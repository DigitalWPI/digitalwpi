<div role="dialog" class="modal select-bookmark-category-modal fade" id="select-bookmark-category-modal" tabindex="-1" aria-labelledby="col_add_title" aria-hidden="true">
  <div class="modal-dialog text-left" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="col_add_title">Select Bookmark Category</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <div class="bookmark-category-error"></div>
          <% if current_user.categories.any? %>
            <%= label_tag 'category', 'Bookmark Category:' %>
            <select id="bookmark-category-select" class="form-control">
              <% current_user.categories.each do |category| %>
                <option value="<%= category.id %>"><%= category.title %></option>
              <% end %>
            </select>
          <% else %>
            <div class="alert alert-info">
              No bookmark categories available. Please create a category first.
            </div>
          <% end %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="select-bookmark-category-modal-cancel" data-dismiss="modal">Cancel</button>
        <%= submit_tag 'Submit', class: 'btn btn-primary', id: "select-bookmark-category-modal-Submit", disabled: current_user.categories.empty? %>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
