<div role="dialog" class="modal bookmark-category-modal fade" id="bookmark-category-modal" tabindex="-1" aria-labelledby="col_add_title" aria-hidden="true">
  <div class="modal-dialog text-left" role="document">
    <%= form_tag(create_category_bookmarks_path, method: "post") do %>
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="col_add_title">Create Bookmark Category</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <div class="bookmark-category-error"></div>
            <%= label_tag 'category', 'Bookmark Category:' %>
            <%= text_field_tag :bookmark_category, "", class: 'form-control', placeholder: "Type title here ..." %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="bookmark-category-modal-cancel" data-dismiss="modal">Cancel</button>
          <%= submit_tag 'Submit', class: 'btn btn-primary', id: "bookmark-category-modal-Submit" %>
        </div>
      </div>
    <% end %>
  </div>
</div>